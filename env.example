# ===== DJANGO НАЛАШТУВАННЯ =====
DEBUG=False
SECRET_KEY=your-secret-key-here-generate-with-get_random_secret_key
ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# ===== MONOBANK API =====
MONOBANK_PRODUCTION_TOKEN=your-production-token
MONOBANK_TEST_TOKEN=your-test-token

# ===== SITE CONFIGURATION =====
SITE_URL=https://your-domain.com

# ===== SECURITY SETTINGS =====
# HTTPS налаштування (для production)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Шифрування даних клієнтів
ENCRYPTION_KEY=your-encryption-key-32-chars-min
MASK_SENSITIVE_DATA=True

# ===== PRIVACY SETTINGS =====
# Час зберігання персональних даних (в днях)
PERSONAL_DATA_RETENTION_DAYS=365

# Автоматичне видалення старих замовлень
AUTO_DELETE_OLD_ORDERS=False

# ===== OPTIONAL: DATABASE =====
# Якщо перейдете з JSON на БД
# DATABASE_URL=postgresql://user:pass@localhost/dbname

# ===== OPTIONAL: EMAIL =====
# Налаштування для відправки email нотифікацій
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@your-domain.com

# ===== OPTIONAL: SENTRY =====
# Error tracking для production
# SENTRY_DSN=https://...@sentry.io/...

# ===== OPTIONAL: REDIS =====
# Кешування для покращення продуктивності
# REDIS_URL=redis://127.0.0.1:6379/1

# ===== ІНСТРУКЦІЇ =====
# 
# 1. Згенерувати SECRET_KEY:
#    python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
# 2. Згенерувати ENCRYPTION_KEY:
#    python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# 3. Отримати MONOBANK токени:
#    https://web.monobank.ua/
#
# 4. Налаштувати домен:
#    ALLOWED_HOSTS=example.com,www.example.com
#    SITE_URL=https://example.com

